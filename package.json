{
  "name": "skulane",
  "productName": "Skulane",
  "description": "Local-first desktop application for Shopify and WooCommerce store operations",
  "author": {
    "name": "Skulane",
    "email": "mrshahbaznns@gmail.com"
  },
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "app": "electron .",
    "dev": "concurrently -k \"cross-env BROWSER=none npm run react:dev\" \"npm run electron:dev\"",
    "react:dev": "vite --host 127.0.0.1 --port 5173",
    "electron:dev": "cross-env VITE_DEV=true wait-on http://127.0.0.1:5173 && electron .",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win --x64",
    "rebuild": "electron-builder install-app-deps",
    "postinstall": "electron-builder install-app-deps",
    "license:keygen": "node scripts/license-keygen.mjs keygen",
    "license:sign": "node scripts/license-keygen.mjs sign"
  },
  "build": {
    "appId": "com.skulane.desktop",
    "productName": "Skulane",
    "copyright": "Copyright \u00a9 Skulane",
    "asar": true,
    "npmRebuild": true,
    "buildDependenciesFromSource": false,
    "protocols": [
      {
        "name": "Skulane",
        "schemes": [
          "skulane",
          "orderdesk"
        ]
      }
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!**/*.map",
      "!**/*.ts",
      "!**/__tests__/**",
      "!scripts/**"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "win": {
      "target": [
        {
          "target": "appx",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Skulane",
      "runAfterFinish": true
    },
    "appx": {
      "applicationId": "Skulane",
      "identityName": "MuhammadShahbaz.OrderDesk",
      "publisher": "CN=82C2C857-730F-4239-B80D-4F1C7E03E8B4",
      "publisherDisplayName": "Muhammad Shahbaz",
      "displayName": "Skulane",
      "backgroundColor": "#0f172a",
      "languages": [
        "en-US"
      ],
      "showNameOnTiles": true
    }
  },
  "dependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.14.18",
    "@mui/material": "^5.14.18",
    "better-sqlite3": "^9.2.2",
    "fs-extra": "^11.3.4",
    "jsbarcode": "^3.12.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "papaparse": "^5.5.3",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^30.0.0",
    "electron-builder": "^26.8.1",
    "eslint": "^8.53.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.4",
    "globals": "^13.23.0",
    "vite": "^5.0.0",
    "wait-on": "^7.2.0"
  }
}
